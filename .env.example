# Ekhaya Properties — environment variables
# Copy to .env.local for local development.
# Set the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ekhaya-properties.vercel.app

# Optional: Formspree form endpoint (https://formspree.io)
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Optional: Resend API (server-side email)
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=info@ekhaya.co.sz
# CONTACT_FROM_EMAIL=noreply@ekhaya.co.sz

# Optional: Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
